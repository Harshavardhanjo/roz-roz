# Copy to .env.local (gitignored) and fill in.

# Public: read by the browser. Must point at the backend (app/main.py in the repo root).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only: used by app/api/admin/reset-demo/route.ts so the admin token never
# reaches the browser. Must match ADMIN_TOKEN on the backend.
ADMIN_TOKEN=change-me-admin

# Server-only: if the backend isn't reachable at NEXT_PUBLIC_API_BASE_URL from the
# Next.js server process itself (e.g. different internal URL on Render), set this.
# BACKEND_API_BASE_URL=http://localhost:8000
