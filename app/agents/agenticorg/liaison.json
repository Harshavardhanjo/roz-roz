      "url": "https://roz-roz.vercel.app/tools/create_advance_request",
      "headers": {
        "Authorization": "Bearer <TOOLS_TOKEN from the backend's Vercel env; never commit it>",
        "Content-Type": "application/json"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "args": {
            "description": "create_advance_request and create_grocery_request.",
            "properties": {
              "employment_id": {
                "format": "uuid",
                "title": "Employment Id",
                "type": "string"
              },
              "amount_paise": {
                "exclusiveMinimum": 0,
                "maximum": 10000000,
                "title": "Amount Paise",
                "type": "integer"
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Note"
              },
              "source_message_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Source Message Id"
              }
            },
            "required": [
              "employment_id",
              "amount_paise"
            ],
            "title": "CreateMoneyRequestArgs",
            "type": "object"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Exactly the pattern given in the task's rules, with n = this call's index from 0."
          },
          "agent_run_id": {
            "type": "string",
            "description": "The task's agent_run_id, unchanged."
          }
        },
        "required": [
          "args",
          "idempotency_key",
          "agent_run_id"
        ],
        "additionalProperties": false
      },
      "response": "Always HTTP 200: {\"ok\": true, \"result\": {...}} or {\"ok\": false, \"error\": {\"code\", \"message\"}}."
    },
