# Backend (Render's postgresql:// URLs work as-is)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rozroz
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated origins allowed by CORS (local Next.js + the deployed web app)
WEB_ORIGIN=http://localhost:3000
TOOLS_TOKEN=change-me
ADMIN_TOKEN=change-me-admin
# true = serve the example payloads with no database (app/stub_api.py)
USE_STUBS=false
ENABLE_SCHEDULER=true
# Vercel Cron sends this as a bearer token to /api/cron/payday
CRON_SECRET=
# Pin "today" for rehearsals, e.g. 2026-10-24; leave empty for the real date (IST)
TODAY_OVERRIDE=

# Grantex (not wired yet; limits are enforced locally)
GRANTEX_API_KEY=
GRANTEX_AGENT_ID=

# WhatsApp Cloud API (Divyansh; values from Venky's Meta setup)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=change-me
WA_GRAPH_VERSION=v21.0
# Roz Roz's Indian WhatsApp Business number, digits with country code (used for the helper's wa.me link)
WA_BUSINESS_NUMBER=

# ElevenLabs (Divyansh)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# Agents (Divyansh): off | local | agenticorg. "off" = the backend runs the treasurer steps itself.
AGENT_RUNTIME=off
AGENTICORG_BASE_URL=
AGENTICORG_API_KEY=
LIAISON_AGENT_ID=
TREASURER_AGENT_ID=
ANTHROPIC_API_KEY=

# Demo seed: the team member's WhatsApp numbers playing Lakshmi and Ramesh
DEMO_HELPER_E164=+910000000001
DEMO_HELPER2_E164=+910000000002
